# Copy to .env — `just` and the backend both load it automatically.

# Required
# The compose database listens on host port 55432 (override with AX_PG_PORT).
DATABASE_URL=postgres://postgres:password@localhost:55432/ax

# Server binding (defaults shown). PORT=0 picks a free port and writes it to PORT_FILE.
# HOST=0.0.0.0
# PORT=8000
# PORT_FILE=.server-port

# Where uploads are stored (default: ./uploads)
# UPLOAD_DIR=uploads

# Session cookie signing key, at least 32 characters.
# Without it a random key is used and every restart signs everyone out.
# SESSION_SECRET_KEY=change-me-to-a-long-random-string-of-32-plus-chars

# Per-IP rate limit (requests replenished per second / burst allowance)
# RATE_LIMIT_PER_SECOND=20
# RATE_LIMIT_BURST=50
# Behind a reverse proxy, key the rate limit on X-Real-IP / X-Forwarded-For.
# TRUST_PROXY=false

# Restrict cross-origin API access (unset = any origin; not needed when the
# frontend proxies /api, as both the Vite dev server and nginx do).
# CORS_ALLOWED_ORIGINS=https://ax.example.com
# Send the session cookie over HTTPS only.
# SESSION_COOKIE_SECURE=false

# PostgreSQL pool size and how long a request waits for a connection.
# DB_MAX_CONNECTIONS=10
# DB_ACQUIRE_TIMEOUT_SECS=5

# Max total size of one upload request, in MB.
# MAX_UPLOAD_MB=300
# Grace period for in-flight requests on shutdown.
# SHUTDOWN_TIMEOUT_SECS=30

# Optional: AI-generated titles for posts published without one.
# Any OpenAI-compatible endpoint works. Leave OPENAI_API_KEY unset to disable.
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Logging (tracing EnvFilter syntax)
# RUST_LOG=info,sqlx=warn
